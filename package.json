{
  "name": "cypress_automationteststore",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test:single": "cypress run --spec",
    "cy:run:chrome": "cypress run --browser chrome",
    "cy:run:firefox": "cypress run --browser firefox",
    "test:smoke": "cypress run --expose grepTags=@smoke",
    "test:regression": "cypress run --expose grepTags=@regression",
    "test:ui": "cypress run --expose grepTags=@ui",
    "test:api": "cypress run --expose grepTags=@api",
    "test:mocked": "cypress run --expose grepTags=@mocked",
    "test:negative": "cypress run --expose grepTags=@negative",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality:check": "npm run typecheck && npm run lint && npm run format:check",
    "prepare": "husky",
    "report:clean": "rimraf reports/allure-results reports/allure-report reports/screenshots reports/videos reports/downloads",
    "report:generate": "allure generate reports/allure-results --output reports/allure-report",
    "report:open": "allure open reports/allure-report",
    "test:ci": "npm run report:clean && npm run cy:run",
    "test:ci:smoke": "npm run report:clean && npm run test:smoke",
    "test:ci:regression": "npm run report:clean && npm run test:regression",
    "test:allure:open": "npm run test:ci && npm run report:generate && npm run report:open"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@cypress/grep": "^6.0.0",
    "@eslint/js": "^10.0.1",
    "allure": "^3.8.2",
    "allure-cypress": "^3.9.0",
    "allure-js-commons": "^3.9.0",
    "cypress": "^15.15.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^6.4.1",
    "eslint-plugin-mocha": "^11.3.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "3.8.3",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.4"
  }
}
