{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "types": ["cypress", "node", "@cypress/grep"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "paths": {
      "@pages/*": ["./cypress/pages/*"],
      "@selectors/*": ["./cypress/selectors/*"],
      "@flows/*": ["./cypress/flows/*"],
      "@fixtures/*": ["./cypress/fixtures/*"],
      "@support/*": ["./cypress/support/*"],
      "@app-types/*": ["./cypress/types/*"],
      "@utils/*": ["./cypress/utils/*"],
      "@api/*": ["./cypress/api/*"],
      "@config/*": ["./cypress/config/*"],
      "@test-data/*": ["./cypress/test-data/*"]
    }
  },
  "include": ["cypress/**/*.ts", "cypress.config.ts"],
  "exclude": ["node_modules"]
}
